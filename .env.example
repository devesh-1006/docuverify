# Optional server-side Pinata credentials. Keep the actual token in .env only.
IPFS_API_TOKEN=
IPFS_API_URL=https://api.pinata.cloud/pinning/pinFileToIPFS
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Local-only API settings.
API_PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Public frontend settings (not secrets).
VITE_API_BASE_URL=http://localhost:3001
VITE_IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
